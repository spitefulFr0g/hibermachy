#!/usr/bin/env node

import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const [command, ...arguments_] = process.argv.slice(2);
const rootIndex = arguments_.indexOf("--root");
const root = rootIndex >= 0 ? arguments_[rootIndex + 1] : "";

function inventory() {
  const statusPath = path.join(path.dirname(fileURLToPath(import.meta.url)), "status");
  const result = spawnSync(statusPath, ["status", "--root", root], { encoding: "utf8" });
  try { return JSON.parse(result.stdout); } catch { return { schemaVersion: 1, actionable: true, unavailable: true }; }
}
function fail(reasonCode, details = {}) {
  process.stderr.write(JSON.stringify({ kind: "refused", reasonCode, inventory: inventory(), ...details }) + "\n");
  process.exitCode = 1;
}
function read(file) { return fs.readFileSync(path.join(root, file), "utf8"); }
function exists(file) { try { return fs.existsSync(path.join(root, file)); } catch { return false; } }
function regular(file) { try { return fs.lstatSync(path.join(root, file)).isFile(); } catch { return false; } }
function lstat(file) { try { return fs.lstatSync(path.join(root, file)); } catch { return undefined; } }
function fixtureOk(file, required = []) { return regular(file) && required.every((entry) => read(file).includes(entry)); }

function event(name) {
  fs.appendFileSync(path.join(root, "lifecycle-events"), `${name}\n`);
}
function fixtureValue(file, key) {
  if (!regular(file)) return "";
  const match = read(file).match(new RegExp(`(?:^|\\s)${key}=([^\\s]+)`));
  return match ? match[1] : "";
}
function writeJson(file, value) {
  fs.writeFileSync(path.join(root, file), `${JSON.stringify(value)}\n`);
}
function lifecycleState() {
  try { return JSON.parse(read("lifecycle-state.json")); } catch { return {}; }
}
function recordLifecycle(operation, phase, extra = {}) {
  writeJson("lifecycle-state.json", { schemaVersion: 1, operation, phase, ...extra });
}
function interrupted(step) {
  return fixtureValue("interrupt", "after") === step;
}
function uninstallFail(reasonCode, step) {
  return { kind: "refused", operation: "uninstall", reasonCode, failedStep: step, inventory: inventory() };
}
function recognizedPolicy(file) {
  if (!regular(file)) return false;
  const lines = read(file).split("\n");
  return lines.length === 5 &&
    lines[0] === "# Managed by Hibermachy. Do not edit." &&
    lines[1] === "[Sleep]" && /^HibernateDelaySec=[0-9]+s$/.test(lines[2]) &&
    /^HibernateOnACPower=(yes|no)$/.test(lines[3]) && lines[4] === "" &&
    Number(lines[2].slice("HibernateDelaySec=".length, -1)) >= 900 && Number(lines[2].slice("HibernateDelaySec=".length, -1)) <= 604800;
}
function compatibleManifest(file = "plugin/manifest.json") {
  try {
    const value = JSON.parse(read(file));
    if (value.id !== "dev.hibermachy" || value.schemaVersion !== 1 ||
        !value.protocol || !Number.isInteger(value.protocol.min) || !Number.isInteger(value.protocol.max) ||
        value.protocol.min > value.protocol.max) throw new Error();
    return value;
  } catch { throw new Error("HBR-RECOVERY-CHECKOUT-INCOMPATIBLE"); }
}
function recoverCheckout(previousState = lifecycleState()) {
  if (regular("plugin/manifest.json")) {
    compatibleManifest();
    return "present";
  }
  if (previousState.operation === "uninstall" && previousState.phase === "completed") return "already-removed";
  if (!fixtureOk("native-plugin-add", ["accepted=true", "reviewed=true", "disabled=true"]) ||
      !regular("recovered-plugin-manifest.json")) throw new Error("HBR-RECOVERY-NATIVE-ADD-REQUIRED");
  const checkoutPath = lstat("plugin");
  if (checkoutPath && (checkoutPath.isSymbolicLink() || !checkoutPath.isDirectory())) throw new Error("HBR-RECOVERY-CHECKOUT-UNSAFE");
  const plugin = compatibleManifest("recovered-plugin-manifest.json");
  fs.mkdirSync(path.join(root, "plugin"), { recursive: true });
  fs.copyFileSync(path.join(root, "recovered-plugin-manifest.json"), path.join(root, "plugin/manifest.json"));
  writeJson("activation.json", { enabled: false });
  event("checkout-readded");
  recordLifecycle("uninstall", "checkout-readded", { recovery: { checkout: "re-added" } });
  return "re-added";
}
function protocolOverlaps(plugin, helperProtocol) {
  const match = helperProtocol.match(/^protocol-min=(\d+) protocol-max=(\d+)$/);
  if (!match) return false;
  const min = Number(match[1]), max = Number(match[2]);
  return min <= max && plugin.protocol.min <= plugin.protocol.max && min <= plugin.protocol.max && max >= plugin.protocol.min;
}
function recoverHelper(plugin, policyFile) {
  if (!recognizedPolicy(policyFile)) return "not-needed";
  const ownedPackage = regular("helper/package") && regular("helper/package.owner") &&
    read("helper/package.owner") === "owner=pacman\n" && /^package=hibermachy-helper version=\d+\.\d+\.\d+\n$/.test(read("helper/package"));
  if (regular("helper/package") && !ownedPackage) throw new Error("HBR-RECOVERY-HELPER-UNSAFE");
  if (ownedPackage && protocolOverlaps(plugin, read("helper/protocol").trim())) return "present";
  if (regular("helper/package") && regular("helper/protocol")) throw new Error("HBR-RECOVERY-PROTOCOL-MISMATCH");
  if (!fixtureOk("helper-build", ["success=true", "user=unprivileged", "source=immutable", "signature=valid", "checksum=valid"])) throw new Error("HBR-RECOVERY-HELPER-BUILD-REQUIRED");
  if (!fixtureOk("package-install", ["success=true", "authorization=interactive"])) throw new Error("HBR-RECOVERY-PACKAGE-INSTALL-REQUIRED");
  fs.mkdirSync(path.join(root, "helper"), { recursive: true });
  fs.writeFileSync(path.join(root, "helper/package"), `package=hibermachy-helper version=${plugin.version}\n`);
  fs.writeFileSync(path.join(root, "helper/package.owner"), "owner=pacman\n");
  fs.writeFileSync(path.join(root, "helper/protocol"), `protocol-min=${plugin.protocol.min} protocol-max=${plugin.protocol.max}\n`);
  event("helper-reinstalled");
  recordLifecycle("uninstall", "helper-reinstalled", { recovery: { helper: "reinstalled" } });
  return "reinstalled";
}
function removeMenuEntries() {
  const menuName = regular("menu.jsonc") ? "menu.jsonc" : "menu.json";
  if (!exists(menuName)) return "unchanged";
  const menuPath = path.join(root, menuName);
  if (fs.lstatSync(menuPath).isSymbolicLink()) throw new Error("HBR-MENU-INACCESSIBLE");
  if (!regular(path.relative(root, menuPath))) throw new Error("HBR-MENU-MISSING");
  const source = fs.readFileSync(menuPath, "utf8");
  let document;
  try { document = JSON.parse(withoutComments(source)); } catch { throw new Error("HBR-MENU-MALFORMED"); }
  const entries = Array.isArray(document.entries) ? document.entries : Object.entries(document).map(([id, value]) => ({ id, ...value }));
  for (const entry of entries.filter((candidate) => candidate?.id === "setup.hibermachy" || candidate?.id === "system.hibermachy-staged-sleep")) {
    if (entry.managedBy !== "hibermachy") throw new Error("HBR-MENU-MANAGED-MODIFIED");
  }
  const ids = /setup\.hibermachy|system\.hibermachy-staged-sleep/;
  const lines = source.split("\n");
  const candidate = lines.filter((line) => !(ids.test(line) && /managedBy["']?\s*:\s*["']hibermachy/.test(line))).join("\n");
  const cleaned = candidate.replace(/,\s*([}\]])/g, "$1");
  if (cleaned !== source) fs.writeFileSync(menuPath, cleaned);
  return cleaned === source ? "unchanged" : "removed";
}
function uninstall() {
  const owner = regular("installation-owner") && read("installation-owner").startsWith("owner=");
  const scope = "machine-wide helper and requested policy; user-owned checkout, menu, configuration, and outcome history";
  if (!owner) return uninstallFail("HBR-LIFECYCLE-OWNER-UNRECOGNIZED", "inventory");
  const policyFile = "etc/systemd/sleep.conf.d/90-hibermachy.conf";
  const policyPath = path.join(root, policyFile);
  const recovery = arguments_.includes("--recover") || command === "purge";
  const previousLifecycleState = lifecycleState();
  recordLifecycle("uninstall", "started", { recoveryRequested: recovery });
  let recoveryResult = { checkout: "not-needed", helper: "not-needed" };
  if (recovery && !regular("plugin/manifest.json")) recoveryResult.checkout = recoverCheckout(previousLifecycleState);
  const plugin = regular("plugin/manifest.json") ? compatibleManifest() : undefined;
  if (recognizedPolicy(policyFile) && (!regular("helper/package") || !regular("helper/protocol"))) {
    if (!recovery || !plugin) throw new Error("HBR-RECOVERY-HELPER-REQUIRED");
    recoveryResult.helper = recoverHelper(plugin, policyFile);
  } else if (recognizedPolicy(policyFile) && plugin) {
    recoveryResult.helper = recoverHelper(plugin, policyFile);
  }
  if (regular("activation.json") && JSON.parse(read("activation.json")).enabled === true) {
    if (!fixtureOk("native-disable", ["success=true"])) return uninstallFail("HBR-LIFECYCLE-DISABLE-FAILED", "disable");
    fs.writeFileSync(path.join(root, "activation.json"), '{"enabled":false}\n');
  }
  recordLifecycle("uninstall", "disabled", { recovery: recoveryResult });
  event("disable");
  if (interrupted("disable")) return uninstallFail("HBR-LIFECYCLE-INTERRUPTED", "disable");

  if (exists("policy-reset")) {
    const authorization = fixtureValue("policy-reset", "authorization");
    if (authorization === "cancelled") return uninstallFail("HBR-SYSTEM-POLICY-AUTH-CANCELLED", "policy-reset-authentication");
    if (authorization === "denied") return uninstallFail("HBR-SYSTEM-POLICY-AUTH-DENIED", "policy-reset-authentication");
    if (authorization !== "accepted") return uninstallFail("HBR-SYSTEM-POLICY-AUTH-UNAVAILABLE", "policy-reset-authentication");
    event("policy-reset-authenticated");
    if (fixtureValue("policy-reset", "reset") !== "success") return uninstallFail("HBR-SYSTEM-POLICY-RESET-FAILED", "policy-reset");
    if (regular(policyFile) && !recognizedPolicy(policyFile)) return uninstallFail("HBR-SYSTEM-POLICY-RESET-REFUSED", "policy-reset");
    const metadata = `${policyFile}.owner`;
    if (regular(policyFile) && (!regular(metadata) || read(metadata) !== "owner=system\nmode=600\nlinks=1\n")) return uninstallFail("HBR-SYSTEM-POLICY-RESET-REFUSED", "policy-ownership");
    if (regular(policyFile)) fs.unlinkSync(policyPath);
    if (exists(metadata)) fs.unlinkSync(path.join(root, metadata));
  } else if (regular(policyFile)) return uninstallFail("HBR-SYSTEM-POLICY-RESET-AUTH-UNAVAILABLE", "policy-reset-authentication");
  event("policy-reset-verified-absent");
  recordLifecycle("uninstall", "policy-reset-verified-absent", { recovery: recoveryResult });
  if (interrupted("policy-reset")) return uninstallFail("HBR-LIFECYCLE-INTERRUPTED", "policy-reset");

  event("package-removal-requested");
  if (!fixtureOk("package-remove", ["success=true", "authorization=interactive"])) return uninstallFail("HBR-PACKAGE-REMOVE-FAILED", "package-removal");
  if (exists("helper/package")) fs.unlinkSync(path.join(root, "helper/package"));
  if (exists("helper/package.owner")) fs.unlinkSync(path.join(root, "helper/package.owner"));
  if (exists("helper/protocol")) fs.unlinkSync(path.join(root, "helper/protocol"));
  event("package-removed");
  recordLifecycle("uninstall", "package-removed", { recovery: recoveryResult });
  if (interrupted("package-removal")) return uninstallFail("HBR-LIFECYCLE-INTERRUPTED", "package-removal");
  if (regular(policyFile)) return uninstallFail("HBR-SYSTEM-POLICY-ABSENCE-INDETERMINATE", "policy-verification");
  const menu = removeMenuEntries();
  event(`menu-${menu}`);
  if (interrupted("menu")) return uninstallFail("HBR-LIFECYCLE-INTERRUPTED", "menu");
  if (exists("plugin")) {
    if (fs.lstatSync(path.join(root, "plugin")).isSymbolicLink()) return uninstallFail("HBR-CHECKOUT-INACCESSIBLE", "checkout-removal");
    fs.rmSync(path.join(root, "plugin"), { recursive: true, force: false });
  }
  event("checkout-removed");
  recordLifecycle("uninstall", "completed", { recovery: recoveryResult });
  return {
    kind: "accepted", operation: "uninstall", installationOwner: read("installation-owner").trim(), scope,
    activation: "disabled", policyReset: "verified-absent", helper: "removed", menu, checkout: "removed", recovery: recoveryResult,
    retained: { userConfiguration: exists("user/config.json"), outcomeHistory: exists("user/state.json") }, inventory: inventory()
  };
}

const purgeScopes = [
  { name: "userConfiguration", path: "user/config.json", description: "installation owner's Hibermachy configuration" },
  { name: "outcomeHistory", path: "user/state.json", description: "installation owner's Hibermachy outcome history" }
];

function validatePurgePath(relativePath) {
  const rootStat = lstat(".");
  const userStat = lstat("user");
  const targetStat = lstat(relativePath);
  const owner = process.getuid();
  if (!rootStat || rootStat.isSymbolicLink() || rootStat.uid !== owner ||
      !userStat || userStat.isSymbolicLink() || !userStat.isDirectory() || userStat.uid !== owner ||
      (targetStat && (targetStat.isSymbolicLink() || !targetStat.isFile() || targetStat.uid !== owner || targetStat.mode & 0o077))) {
    throw new Error("HBR-PURGE-UNSAFE-PATH");
  }
  return targetStat ? "present" : "absent";
}

function purge() {
  const result = uninstall();
  const scopes = purgeScopes.map((scope) => ({ ...scope, state: validatePurgePath(scope.path) }));
  if (arguments_.includes("--cancel-purge")) {
    return { ...result, purge: "retained", purgeScopes: scopes };
  }
  if (!arguments_.includes("--confirm-purge")) {
    const error = new Error("HBR-PURGE-CONFIRMATION-REQUIRED");
    error.details = { operation: "uninstall", purge: "confirmation-required", purgeScopes: scopes, retained: result.retained };
    throw error;
  }
  for (const scope of scopes) {
    if (scope.state === "present") {
      fs.unlinkSync(path.join(root, scope.path));
      if (interrupted(`purge-${scope.name === "userConfiguration" ? "config" : "state"}`)) {
        throw new Error("HBR-LIFECYCLE-INTERRUPTED");
      }
      if (lstat(scope.path)) throw new Error("HBR-PURGE-ABSENCE-UNVERIFIED");
    }
  }
  return {
    kind: "accepted", operation: "purge", installationOwner: result.installationOwner,
    purge: "removed", purgeScopes: scopes,
    finalInventory: Object.fromEntries(purgeScopes.map((scope) => [scope.name, lstat(scope.path) ? "present" : "absent"])),
    inventory: inventory()
  };
}

function withoutComments(source) {
  let output = "", string = false, escaped = false;
  for (let i = 0; i < source.length; i += 1) {
    const character = source[i], next = source[i + 1];
    if (string) {
      output += character;
      if (escaped) escaped = false; else if (character === "\\") escaped = true; else if (character === '"') string = false;
    } else if (character === '"') { string = true; output += character;
    } else if (character === "/" && next === "/") { while (i < source.length && source[i] !== "\n") i += 1; output += "\n";
    } else if (character === "/" && next === "*") { i += 2; while (i < source.length && !(source[i] === "*" && source[i + 1] === "/")) i += 1; i += 1;
    } else output += character;
  }
  return output;
}

function matchingArrayEnd(source, start) {
  let depth = 0, string = false, escaped = false, lineComment = false, blockComment = false;
  for (let i = start; i < source.length; i += 1) {
    const character = source[i], next = source[i + 1];
    if (lineComment) { if (character === "\n") lineComment = false; continue; }
    if (blockComment) { if (character === "*" && next === "/") { blockComment = false; i += 1; } continue; }
    if (string) { if (escaped) escaped = false; else if (character === "\\") escaped = true; else if (character === '"') string = false; continue; }
    if (character === '"') { string = true; continue; }
    if (character === "/" && next === "/") { lineComment = true; i += 1; continue; }
    if (character === "/" && next === "*") { blockComment = true; i += 1; continue; }
    if (character === "[") depth += 1;
    if (character === "]" && --depth === 0) return i;
  }
  return -1;
}

const menuEntries = [
  { id: "setup.hibermachy", value: { managedBy: "hibermachy", label: "Sleep & Hibernation", aliases: ["sleep", "hibernate", "Hibermachy"], description: "Configure Hibermachy sleep and hibernation.", action: "omarchy-shell shell summon dev.hibermachy '{}'", when: "quickshell ipc call dev.hibermachy status >/dev/null 2>&1" } },
  { id: "system.hibermachy-staged-sleep", value: { managedBy: "hibermachy", label: "Suspend then Hibernate", aliases: ["sleep", "hibernate", "Hibermachy"], description: "Request Hibermachy staged sleep.", action: "quickshell ipc call dev.hibermachy requestStagedSleep", when: "quickshell ipc call dev.hibermachy status >/dev/null 2>&1" } }
];
function sameEntry(left, right) { return JSON.stringify(left) === JSON.stringify(right); }

function reconcileMenu() {
  const menuPath = path.join(root, "menu.jsonc");
  if (!regular("menu.jsonc")) throw new Error(exists("menu.jsonc") ? "HBR-MENU-INACCESSIBLE" : "HBR-MENU-MALFORMED");
  const source = fs.readFileSync(menuPath, "utf8");
  let document;
  try { document = JSON.parse(withoutComments(source)); } catch { throw new Error("HBR-MENU-MALFORMED"); }
  if (!document || typeof document !== "object" || Array.isArray(document)) throw new Error("HBR-MENU-MALFORMED");
  const arrayMode = Array.isArray(document.entries);
  if (!arrayMode && !Object.keys(document).length) throw new Error("HBR-MENU-MALFORMED");
  const existing = arrayMode ? document.entries.map((entry) => ({ id: entry?.id, value: entry })) : Object.entries(document).map(([id, value]) => ({ id, value }));
  for (const expected of menuEntries) {
    const matches = existing.filter((entry) => entry.id === expected.id);
    if (matches.length > 1 || (matches.length === 1 && matches[0].value?.managedBy !== "hibermachy")) throw new Error("HBR-MENU-ID-COLLISION");
    const expectedValue = arrayMode ? { id: expected.id, ...expected.value } : expected.value;
    if (matches.length === 1 && !sameEntry(matches[0].value, expectedValue)) throw new Error("HBR-MENU-MANAGED-MODIFIED");
  }
  if (menuEntries.every((entry) => existing.some((candidate) => candidate.id === entry.id && sameEntry(candidate.value, arrayMode ? { id: entry.id, ...entry.value } : entry.value)))) return "unchanged";
  if (!arrayMode) {
    const missing = menuEntries.filter((entry) => !Object.hasOwn(document, entry.id));
    const key = /\n([ \t]*)\}\s*$/m.exec(source);
    const close = key ? key.index + key[0].lastIndexOf("}") : -1;
    if (close < 0) throw new Error("HBR-MENU-MALFORMED");
    const indent = key[1] || "  ";
    const text = (Object.keys(document).length ? ",\n" : "\n") + missing.map((entry) => `${indent}${JSON.stringify(entry.id)}: ${JSON.stringify(entry.value)}`).join(",\n") + "\n";
    const temporary = `${menuPath}.hibermachy-${process.pid}.tmp`;
    fs.writeFileSync(temporary, source.slice(0, close) + text + source.slice(close), { mode: fs.statSync(menuPath).mode & 0o777 });
    fs.renameSync(temporary, menuPath);
    return "reconciled";
  }
  const key = /(["']entries["']\s*:\s*)\[/m.exec(source);
  if (!key) throw new Error("HBR-MENU-MALFORMED");
  const open = key.index + key[0].lastIndexOf("[");
  const close = matchingArrayEnd(source, open);
  if (close < 0) throw new Error("HBR-MENU-MALFORMED");
  const missing = menuEntries.filter((entry) => !document.entries.some((candidate) => candidate?.id === entry.id));
  const prefix = document.entries.length ? ",\n" : "\n";
  const indentMatch = source.slice(0, close).match(/\n([ \t]*)[^\n]*$/);
  const indent = indentMatch ? indentMatch[1] : "  ";
  const text = prefix + missing.map((entry) => `${indent}${JSON.stringify({ id: entry.id, ...entry.value })}`).join(",\n") + "\n";
  const temporary = `${menuPath}.hibermachy-${process.pid}.tmp`;
  fs.writeFileSync(temporary, source.slice(0, close) + text + source.slice(close), { mode: fs.statSync(menuPath).mode & 0o777 });
  fs.renameSync(temporary, menuPath);
  return "reconciled";
}

function manifest() {
  try { const value = JSON.parse(read("plugin/manifest.json")); if (value.id !== "dev.hibermachy" || value.schemaVersion !== 1) throw new Error(); return value; }
  catch { throw new Error("HBR-CHECKOUT-INCOMPATIBLE"); }
}
function setup() {
  recordLifecycle("setup", "started");
  const plugin = manifest();
  if (!fixtureOk("native-plugin-review", ["reviewed=true"])) throw new Error("HBR-LIFECYCLE-NATIVE-REVIEW-REQUIRED");
  if (!fixtureOk("quattro-contract", ["compatible=true"])) throw new Error("HBR-QUATTRO-CONTRACT-INCOMPATIBLE");
  if (!fixtureOk("helper-build", ["success=true", "user=unprivileged"])) throw new Error("HBR-HELPER-BUILD-FAILED");
  if (!fixtureOk("package-install", ["success=true", "authorization=interactive"])) throw new Error("HBR-PACKAGE-INSTALL-FAILED");
  fs.mkdirSync(path.join(root, "helper"), { recursive: true });
  fs.writeFileSync(path.join(root, "helper/package"), "package=hibermachy-helper version=0.1.0\n");
  fs.writeFileSync(path.join(root, "helper/package.owner"), "owner=pacman\n");
  fs.writeFileSync(path.join(root, "helper/protocol"), `protocol-min=${plugin.protocol.min} protocol-max=${plugin.protocol.max}\n`);
  recordLifecycle("setup", "helper-installed");
  const menu = reconcileMenu();
  recordLifecycle("setup", "menu-reconciled");
  if (!fixtureOk("probes", ["compatible=true"])) throw new Error("HBR-INTEGRATION-PROBES-INCOMPLETE");
  if (!exists("activation.json")) fs.writeFileSync(path.join(root, "activation.json"), '{"enabled":false}\n');
  const activation = JSON.parse(read("activation.json")).enabled ? "enabled" : "disabled";
  recordLifecycle("setup", "completed", { activation });
  return {
    kind: "accepted", operation: "setup", installationOwnerModel: "one Omarchy desktop user per machine",
    activation, menu, policyMutation: false,
    scopes: { checkout: "compatible", activation, menu: menu === "unchanged" ? "compatible" : "reconciled", helper: "compatible", protocol: "compatible", userData: "retained", requestedSystemPolicy: "untouched" },
    inventory: inventory()
  };
}
function activate(confirm) {
  manifest();
  if (!confirm) {
    recordLifecycle("activation", "declined");
    return { kind: "declined", operation: "activation", activation: "disabled", policyMutation: false };
  }
  fs.writeFileSync(path.join(root, "activation.json"), '{"enabled":true}\n');
  recordLifecycle("activation", "completed", { activation: "enabled" });
  return { kind: "accepted", operation: "activation", activation: "enabled", policyMutation: false };
}

function activation() {
  try {
    const value = JSON.parse(read("activation.json"));
    if (typeof value.enabled !== "boolean") throw new Error();
    return value.enabled;
  } catch { throw new Error("HBR-ACTIVATION-STATE-INVALID"); }
}
function updateIntent() {
  if (!regular("update-intent.json")) {
    const intent = { schemaVersion: 1, priorActivation: activation() ? "enabled" : "disabled", phase: "recorded" };
    writeJson("update-intent.json", intent);
    return intent;
  }
  try {
    const intent = JSON.parse(read("update-intent.json"));
    if (intent.schemaVersion !== 1 || !["enabled", "disabled"].includes(intent.priorActivation) || typeof intent.phase !== "string") throw new Error();
    return intent;
  } catch { throw new Error("HBR-UPDATE-INTENT-INVALID"); }
}
function update() {
  let intent = updateIntent();
  const priorActivation = intent.priorActivation;
  const phase = (next) => { intent = { ...intent, phase: next }; writeJson("update-intent.json", intent); recordLifecycle("update", next, { priorActivation }); };
  manifest();
  if (intent.phase === "recorded") {
    if (activation()) writeJson("activation.json", { enabled: false });
    phase("disabled");
  }
  if (!["native-update-reviewed", "checkout-updated", "helper-built", "helper-upgraded", "menu-reconciled", "probes-rerun", "completed"].includes(intent.phase)) {
    if (!fixtureOk("native-plugin-update", ["reviewed=true"])) throw new Error("HBR-NATIVE-UPDATE-REVIEW-REQUIRED");
    if (read("native-plugin-update").includes("autoAccept=true")) throw new Error("HBR-NATIVE-UPDATE-AUTO-ACCEPT");
    phase("native-update-reviewed");
  }
  if (["native-update-reviewed", "disabled"].includes(intent.phase)) {
    if (!regular("updated-plugin-manifest.json")) throw new Error("HBR-NATIVE-UPDATE-INCOMPLETE");
    const updated = compatibleManifest("updated-plugin-manifest.json");
    fs.copyFileSync(path.join(root, "updated-plugin-manifest.json"), path.join(root, "plugin/manifest.json"));
    phase("checkout-updated");
    void updated;
  }
  const plugin = compatibleManifest();
  if (["checkout-updated", "native-update-reviewed"].includes(intent.phase)) {
    if (!fixtureOk("helper-build", ["success=true", "user=unprivileged", "source=immutable", "signature=valid", "checksum=valid"])) throw new Error("HBR-HELPER-BUILD-FAILED");
    phase("helper-built");
  }
  if (intent.phase === "helper-built") {
    if (!fixtureOk("package-install", ["success=true", "authorization=interactive"])) throw new Error("HBR-PACKAGE-INSTALL-FAILED");
    fs.mkdirSync(path.join(root, "helper"), { recursive: true });
    fs.writeFileSync(path.join(root, "helper/package"), `package=hibermachy-helper version=${plugin.version}\n`);
    fs.writeFileSync(path.join(root, "helper/package.owner"), "owner=pacman\n");
    fs.writeFileSync(path.join(root, "helper/protocol"), `protocol-min=${plugin.protocol.min} protocol-max=${plugin.protocol.max}\n`);
    phase("helper-upgraded");
  }
  if (["helper-upgraded", "menu-reconciled"].includes(intent.phase)) {
    if (!fixtureOk("protocol-probe", ["compatible=true"])) throw new Error("HBR-PROTOCOL-MISMATCH");
    if (intent.phase === "helper-upgraded") {
      reconcileMenu();
      phase("menu-reconciled");
    }
    if (interrupted("update-menu")) throw new Error("HBR-LIFECYCLE-INTERRUPTED");
    if (!fixtureOk("probes", ["compatible=true"])) throw new Error("HBR-INTEGRATION-PROBES-INCOMPLETE");
    phase("probes-rerun");
  }
  if (intent.phase === "probes-rerun") {
    writeJson("activation.json", { enabled: priorActivation === "enabled" });
    phase("completed");
    fs.unlinkSync(path.join(root, "update-intent.json"));
  }
  return { kind: "accepted", operation: "update", activation: priorActivation, priorActivation,
    automaticAcceptance: false, helper: "upgraded", menu: "reconciled", probes: "rerun",
    policyMutation: false, inventory: inventory() };
}

if (!root || !fs.existsSync(root)) fail("HBR-LIFECYCLE-ROOT-REQUIRED");
else if (!["setup", "activate", "update", "uninstall", "purge"].includes(command)) fail("HBR-LIFECYCLE-COMMAND-UNKNOWN");
else { try { const result = command === "setup" ? setup() : command === "activate" ? activate(arguments_.includes("--confirm")) : command === "update" ? update() : command === "uninstall" ? uninstall() : purge(); process.stdout.write(JSON.stringify(result) + "\n"); if (result.kind === "refused") process.exitCode = 1; } catch (error) { fail(error instanceof Error ? error.message : "HBR-LIFECYCLE-FAILED", error?.details ?? {}); } }
